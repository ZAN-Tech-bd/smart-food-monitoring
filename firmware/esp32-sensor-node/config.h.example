// Copy this file to config.h and fill in your own values. config.h is gitignored.

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Local IP (or hostname) of the PC/Pi running the server, e.g. 192.168.1.50
#define SERVER_HOST "192.168.1.50"
#define SERVER_PORT 3000

// How often to read sensors / refresh the LCD (ms)
#define SENSOR_READ_INTERVAL_MS 2000
// How often to POST a reading to the server (ms)
#define SERVER_POST_INTERVAL_MS 30000

// MQ-5 raw ADC thresholds (0-4095 on ESP32). Calibrate for your unit/environment.
#define GAS_WARNING_THRESHOLD 1500
#define GAS_DANGER_THRESHOLD  2800

// HX711 calibration factor: raw_reading / calibration_factor = grams.
// Find this by placing a known weight and adjusting until the output matches.
#define HX711_CALIBRATION_FACTOR 420.0f

// LCD I2C address - try 0x27 first, 0x3F is the other common default.
#define LCD_I2C_ADDRESS 0x27
