// Copy this file to config.h and fill in your own values. config.h is gitignored.

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Local IP (or hostname) of the PC/Pi running the server, e.g. 192.168.1.50
#define SERVER_HOST "192.168.1.50"
#define SERVER_PORT 3000

// How often to capture + upload a photo (ms). Default 4320000 = 72 minutes,
// chosen so ~20 photos/day matches the Gemini free tier's daily quota for
// gemini-3.6-flash - spreads AI feedback evenly across the day instead of
// burning through the quota in the first couple hours. Adjust to match
// GEMINI_DAILY_LIMIT in server/.env if your quota differs (24h / desired
// calls-per-day, in ms).
#define CAPTURE_INTERVAL_MS 4320000
