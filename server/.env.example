# Copy this file to .env and fill in your own values. .env is gitignored.

PORT=3000

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Multimodal Gemini model to use for image analysis.
GEMINI_MODEL=gemini-3.6-flash

# Get a free key at https://console.groq.com/keys - used for frequent
# sensor-only checks (text-only, no vision needed). Groq's free tier has a
# much higher daily limit than Gemini's, so this keeps Gemini's tight quota
# free for photos instead of splitting it between both features.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Thresholds echoed to the dashboard for the gas-level badge (must match firmware config.h).
GAS_WARNING_THRESHOLD=1500
GAS_DANGER_THRESHOLD=2800

# How often (ms) to run a sensor-only Good/Not Good check via Groq. This
# doesn't touch Gemini's quota, so it can run often - default 60000 = 1 minute.
AI_STATUS_INTERVAL_MS=60000

# Max Gemini calls per (roughly) 24h for image analysis. Once used up, image
# checks are skipped locally and return "Unknown" instead of hitting the API -
# avoids 429 error spam once your plan's real daily quota is exhausted. Check
# ai.google.dev/gemini-api/docs/rate-limits for your model's actual free-tier
# limit and set this to match (or a bit under it, for headroom).
GEMINI_DAILY_LIMIT=20
