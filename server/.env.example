# Copy this file to .env and fill in your own values. .env is gitignored.

PORT=3000

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Multimodal Gemini model to use for image analysis.
GEMINI_MODEL=gemini-3.6-flash

# Get a key at https://console.groq.com/keys - used for frequent sensor-only
# checks (text-only, no vision needed), since Groq's free tier has a much
# higher daily limit than Gemini's, keeping Gemini's tight quota free for photos.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Thresholds echoed to the dashboard for the gas-level badge (must match firmware config.h).
GAS_WARNING_THRESHOLD=691
GAS_DANGER_THRESHOLD=1191

# How often (ms) to run a sensor-only Good/Not Good check via Groq. This no
# longer shares Gemini's quota, so it can run frequently - default 60000 = 1 minute.
AI_STATUS_INTERVAL_MS=60000

# Your account's free-tier daily quota for gemini-3.6-flash (image analysis
# only now), confirmed from a real 429 response: 20 requests/day. Once used
# up, checks are skipped locally instead of hitting the API and logging errors.
GEMINI_DAILY_LIMIT=20
